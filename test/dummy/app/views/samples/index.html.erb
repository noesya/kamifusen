<% content_for :title, "Samples" %>

<%= link_to 'New Sample', new_sample_path, class: "btn btn-primary" %>

<table class="table">
  <thead>
    <tr>
      <td>Image</td>
      <td>Actions</td>
    </tr>
  </thead>
  <tbody>
    <% @samples.each do |sample| %>
      <tr>
        <td>
          <% if sample.image.attached? %>
            <%= link_to sample do %>
              <%= image_tag sample.image, width: 200 %>
            <% end %>
          <% else %>
            <%= link_to "Sample ##{sample.id}", sample %>
          <% end %>
        </td>
        <td>
          <%= link_to 'Edit', edit_sample_path(sample), class: "btn btn-sm btn-warning" %>
          <%= link_to 'Destroy', sample, class: "btn btn-sm btn-danger", method: :delete, data: { confirm: 'Are you sure?' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
